# Superset instance URL (without trailing slash)
SUPERSET_BASE_URL=https://superset.example.com

# Service account used by the server itself.
# In google-sso mode it is only used to look up the Superset user behind an
# e-mail address (needs Admin rights on /api/v1/security/users/).
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=your_password

# Authentication provider for the service account login (db, ldap)
SUPERSET_AUTH_PROVIDER=db

# Alternative to username/password: a browser session cookie (SSO instances)
#SUPERSET_SESSION_COOKIE=
#SUPERSET_SESSION_COOKIE_NAME=session

# MCP server settings (optional)
SUPERSET_MCP_HOST=127.0.0.1
SUPERSET_MCP_PORT=8001

# ---------------------------------------------------------------------------
# Per-user mode: every tool call runs as the signed-in Superset user
# ---------------------------------------------------------------------------
# service    - single service account for everyone (upstream behaviour, default)
# google-sso - callers sign in with Google; calls run as their Superset user
SUPERSET_MCP_AUTH_MODE=service

# Public HTTPS URL of this server. Google must list <URL>/auth/callback as an
# authorized redirect URI, and MCP clients discover OAuth metadata under it.
#SUPERSET_MCP_PUBLIC_URL=https://mcp.example.com

# Google OAuth client (Web application)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Restrict the Google account chooser to one Workspace domain. Defaults to the
# single value of SUPERSET_MCP_ALLOWED_DOMAINS when only one is configured.
#GOOGLE_HOSTED_DOMAIN=example.com

# Superset's SECRET_KEY / JWT_SECRET_KEY. Required in google-sso mode: the server
# signs each caller's Superset API token with it, so Superset applies that user's
# own roles, RLS and ownership.
#SUPERSET_JWT_SECRET=
#SUPERSET_JWT_ALGORITHM=HS256
# Lifetime of a minted token, seconds (it is re-minted automatically).
#SUPERSET_MCP_TOKEN_TTL=600

# Client ID Metadata Documents: a client may present a URL as its client_id, which
# this server then fetches from the client's own host. Set to false when that host
# is unreachable from the server - clients fall back to dynamic client registration,
# which needs no outbound call.
#SUPERSET_MCP_ENABLE_CIMD=true

# Comma-separated e-mail domains allowed to use the server. Empty = any domain
# the identity provider accepts.
#SUPERSET_MCP_ALLOWED_DOMAINS=example.com

# Create a Superset account when a signed-in user has none. Off by default:
# prefer letting Superset's own SSO login create the account, otherwise the
# usernames can collide on the unique e-mail column at first UI login.
#SUPERSET_MCP_AUTO_CREATE_USERS=false
#SUPERSET_MCP_DEFAULT_ROLE=Gamma
