# Reverse proxy for mcp-superset-sso, two variants.
#
# Unlike a service-account MCP behind a secret path, this server needs real paths
# at the origin root: clients discover OAuth metadata under /.well-known/ and the
# OAuth endpoints (/authorize, /token, /register, /consent, /auth/callback) live at
# the root. Authentication is the server's job - never inject an Authorization
# header here.
#
# Routes served by the app: /mcp, /health, /.well-known/oauth-authorization-server,
# /.well-known/oauth-protected-resource/mcp, /authorize, /token, /register,
# /consent, /auth/callback.

# ---------------------------------------------------------------------------
# Variant A - dedicated hostname (preferred): the whole origin is the MCP server.
# ---------------------------------------------------------------------------
server {
    server_name mcp-sso.example.com;
    server_tokens off;

    location / {
        proxy_pass http://10.0.0.2:8002;   # host:port of the MCP container

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # streamable-http streams responses - nginx must not buffer them,
        # otherwise larger tool replies stall while small ones pass.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;

        proxy_read_timeout 3600s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 3600s;

        proxy_redirect http:// https://;
    }

    listen 443 ssl;                        # certificate managed by certbot
    # ssl_certificate     /etc/letsencrypt/live/mcp-sso.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mcp-sso.example.com/privkey.pem;
}

server {
    listen 80;
    server_name mcp-sso.example.com;
    return 301 https://$host$request_uri;
}

# ---------------------------------------------------------------------------
# Variant B - share an existing hostname (no new DNS record or certificate).
# Add these locations to that vhost; everything else there keeps working, because
# nginx prefers the more specific location. Set SUPERSET_MCP_PUBLIC_URL to the
# shared hostname.
#
# The metadata prefix is /.well-known/oauth- and NOT /.well-known/, so that
# certbot's /.well-known/acme-challenge/ still reaches nginx on renewal.
# ---------------------------------------------------------------------------
#   location ^~ /.well-known/oauth- { include snippets/mcp-sso.conf; }
#   location = /authorize          { include snippets/mcp-sso.conf; }
#   location = /token              { include snippets/mcp-sso.conf; }
#   location = /register           { include snippets/mcp-sso.conf; }
#   location = /consent            { include snippets/mcp-sso.conf; }
#   location ^~ /auth/             { include snippets/mcp-sso.conf; }   # /auth/callback
#   location = /mcp                { include snippets/mcp-sso.conf; }
#   location ^~ /mcp/              { include snippets/mcp-sso.conf; }
#
#   # Health under its own path, so it does not collide with the host's own /health.
#   location = /mcp-sso-health {
#       include snippets/mcp-sso.conf;
#       rewrite ^.*$ /health break;
#   }
#
# where snippets/mcp-sso.conf holds the proxy_pass and the proxy_* directives from
# variant A. Do not share the hostname with an app that already serves any of these
# paths (Superset itself, for instance, may expose /health and /mcp).
